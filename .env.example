# FieldNote — Environment Variables Example
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
#
# The app works fully without these variables.
# If MONGODB_URI is absent, every /api endpoint returns:
#   503 { code: "SYNC_NOT_CONFIGURED" }
# and the UI shows "Sync isn't configured in this deployment."

# MongoDB Atlas connection string (Phase 7 optional backend sync)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign and verify JWTs (at least 32 random characters)
JWT_SECRET=

# Allowed CORS origin for the /api endpoints (your frontend URL)
# Example: https://fieldnote.example.com
ALLOWED_ORIGIN=
